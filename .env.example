# AETHER-ML environment template. Copy to .env and fill in locally. Never commit .env.

# --- Application ---
AETHER_ENV=development
AETHER_CONFIG=configs/aether.yaml
AETHER_LOG_LEVEL=INFO

# --- Storage / database ---
# SQLite is used for local development and tests. PostgreSQL for staging/production:
# DATABASE_URL=postgresql+psycopg://aether:aether@localhost:5432/aether
DATABASE_URL=sqlite:///./artifacts/db/aether.db
AETHER_ARTIFACTS_ROOT=artifacts

# --- API security ---
# Required when api.auth.enabled is true. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
AETHER_API_TOKEN=
AETHER_CORS_ORIGINS=http://localhost:5173

# --- Experiment tracking (optional) ---
AETHER_MLFLOW_TRACKING_URI=file:./mlruns
AETHER_MLFLOW_EXPERIMENT=aether-ml

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
